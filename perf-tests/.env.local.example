# Copia esto a perf-tests/.env.local para que las pruebas apunten al
# Supabase LOCAL (Docker) en vez de producción. Con `supabase start` corriendo,
# estas son las credenciales fijas de siempre (mismas para cualquier instalación
# local sin personalizar, publicadas en la documentación de Supabase CLI):

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Solo lo usa perf-tests/setup-local-db.mjs para crear al usuario de prueba
# (auth.admin API). NUNCA definas esto para producción.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Cuenta de prueba que crea setup-local-db.mjs en la base local.
PERF_TEST_EMAIL=perf-tests@example.com
PERF_TEST_PASSWORD=perf-tests-local-123

# Ya no hace falta confirmación manual contra una base local desechable.
PERF_TEST_CONFIRM=I_UNDERSTAND
